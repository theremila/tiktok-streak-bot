[Unit]
Description=TikTok Streak Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tiktok-streak-bot
ExecStart=/opt/tiktok-streak-bot/venv/bin/python main.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

MemoryMax=800M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
