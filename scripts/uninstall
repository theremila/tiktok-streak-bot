#!/usr/bin/env bash
set -euo pipefail

destination=${TIKTOK_BOT_DESTINATION:-/opt/tiktok-streak-bot}
ssh_port=${TIKTOK_BOT_SSH_PORT:-22}
ssh_user=${TIKTOK_BOT_SSH_USER:-root}
ssh_host=${TIKTOK_BOT_SSH_HOST:-}
ssh_password=${TIKTOK_BOT_SSH_PASSWORD:-}
purge=false

usage() {
    cat <<'EOF'
Usage: scripts/uninstall --host HOST [options]

Stops and removes the Docker Compose deployment over SSH. Configuration, cookies,
and logs remain on the server unless --purge is explicitly supplied.

Options:
  --host HOST          Server address (required)
  --port PORT          SSH port (default: 22)
  --user USER          SSH user (default: root)
  --password PASSWORD  SSH password; prefer TIKTOK_BOT_SSH_PASSWORD
  --destination PATH   Remote directory (default: /opt/tiktok-streak-bot)
  --purge              Also remove the remote application directory
  -h, --help           Show this help

Environment equivalents: TIKTOK_BOT_SSH_HOST, TIKTOK_BOT_SSH_PORT,
TIKTOK_BOT_SSH_USER, TIKTOK_BOT_SSH_PASSWORD, TIKTOK_BOT_DESTINATION.
EOF
}

while (($#)); do
    case $1 in
        --host) ssh_host=${2:?Missing host}; shift 2 ;;
        --port) ssh_port=${2:?Missing port}; shift 2 ;;
        --user) ssh_user=${2:?Missing user}; shift 2 ;;
        --password) ssh_password=${2:?Missing password}; shift 2 ;;
        --destination) destination=${2:?Missing destination}; shift 2 ;;
        --purge) purge=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

read_value() {
    local prompt=$1 variable=$2 value
    [[ -n ${!variable} ]] && return
    read -r -p "$prompt: " value
    printf -v "$variable" '%s' "$value"
}

read_value 'Server address' ssh_host
read_value 'SSH port' ssh_port
read_value 'SSH user' ssh_user
read_value 'Remote directory' destination

if [[ -z $ssh_password && ! -t 0 ]]; then
    printf 'Set TIKTOK_BOT_SSH_PASSWORD or use an SSH key in non-interactive mode.\n' >&2
    exit 2
fi
if [[ -z $ssh_password ]]; then
    read -r -s -p 'SSH password (leave empty to use SSH key): ' ssh_password
    printf '\n'
fi

ssh_command=(ssh -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new -p "$ssh_port" "$ssh_user@$ssh_host")
if [[ -n $ssh_password ]]; then
    command -v sshpass >/dev/null || { printf 'sshpass is required for password authentication.\n' >&2; exit 1; }
    ssh_command=(sshpass -p "$ssh_password" "${ssh_command[@]}")
fi

"${ssh_command[@]}" "set -eu
    target='$destination'
    if [ -f \"\$target/docker-compose.yml\" ]; then
        cd \"\$target\"
        docker compose down --remove-orphans
    fi
    if [ '$purge' = true ]; then
        case \"\$target\" in /|/root|/home) exit 2;; esac
        rm -rf \"\$target\"
    fi"

printf 'Deployment removed. Remote data was %s.\n' "$([[ $purge == true ]] && printf removed || printf retained)"
